SECRET_KEY=change-this-to-a-long-random-secret-key
DATABASE_URL=sqlite:///foodwise.db
FLASK_ENV=development
FLASK_DEBUG=1

# AI/LLM Integration (optional - falls back to rule-based assistant if not set)
AI_PROVIDER=
AI_API_KEY=
# Supported providers: openai, gemini, watsonx

# IBM watsonx (optional)
WATSONX_URL=
WATSONX_PROJECT_ID=

# Admin seed
ADMIN_EMAIL=admin@foodwise.ai
ADMIN_PASSWORD=Admin@123
